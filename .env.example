WP_ENV=production
WP_HOME=http://tavernenfest.medienartelier.de
WP_SITEURL=http://tavernenfest.medienartelier.de

DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=database_password
DB_HOST=database_host
DB_CHARSET=utf8mb4
DB_COLLATE=

WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=false
DISALLOW_FILE_EDIT=true

AUTH_KEY=change-me
SECURE_AUTH_KEY=change-me
LOGGED_IN_KEY=change-me
NONCE_KEY=change-me
AUTH_SALT=change-me
SECURE_AUTH_SALT=change-me
LOGGED_IN_SALT=change-me
NONCE_SALT=change-me
